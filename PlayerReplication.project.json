{
  "name": "PlayerReplication",
  
  "tree": {
    "$ignoreUnknownInstances": true,
    "$className": "DataModel",

    "ReplicatedFirst": {
      "$ignoreUnknownInstances": true,
      
      "Bootstrappers": {
        "$path": "Source/Bootstrappers/Client"
      }
    },

    "ReplicatedStorage": {
      "$ignoreUnknownInstances": true,
      
      "Assets": {
        "$ignoreUnknownInstances": true,
        "$path": "Source/Assets"
      },
      
      "Events": {
        "$ignoreUnknownInstances": true,
        "$path": "Source/Events"
      },

      "Packages": {
        "$ignoreUnknownInstances": true,

        "$path": "Packages",
        
        "Configuration": {
          "$ignoreUnknownInstances": true,
          "$path": "Source/Configuration"
        },
        
        "Utility": {
          "$ignoreUnknownInstances": true,
          "$path": "Source/Troubleshooting/Developer/Client/Utility"
        }
      }
    },

    "ServerScriptService": {
      "$ignoreUnknownInstances": true,

      "Temporary": {
        "$ignoreUnknownInstances": true,
        "$path": "Source/Temporary/Server",
        
        "Developer": {
          "$ignoreUnknownInstances": true,
          "$path": "Source/Troubleshooting/Developer/Server/Scripts"
        }
      },
      
      "Bootstrappers": {
        "$ignoreUnknownInstances": true,
        "$path": "Source/Bootstrappers/Server",
        
        "CommandSystemBootstrapper": {
          "$path": "Source/Troubleshooting/CMDR/Server"
        }
      }
    },

    "ServerStorage": {
      "$ignoreUnknownInstances": true,
      
      "ServerPackages": {
        "$ignoreUnknownInstances": true,
        "$path": "ServerPackages",
        
        "Utility": {
          "$ignoreUnknownInstances": true,
          "$path": "Source/Troubleshooting/Developer/Server/Utility"
        }
      },
      
      "Commands": {
        "$ignoreUnknownInstances": true,
        "$path": "Source/Troubleshooting/CMDR/Commands"
      }
    },
    
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$ignoreUnknownInstances": true,
        
        "Temporary": {
          "$ignoreUnknownInstances": true,
          "$path": "Source/Temporary/Client",
          
          "Developer": {
            "$ignoreUnknownInstances": true,
            "$path": "Source/Troubleshooting/Developer/Client/Scripts"
          },
          
          "Iris": {
            "$path": "Source/Troubleshooting/Iris"
          },
          
          "CommandSystemBootstrapper": {
            "$path": "Source/Troubleshooting/CMDR/Client"
          }
        }
      }
    }
  }
}